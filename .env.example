# Copy to .env and fill in. Everything is optional: without a key the service
# answers with the offline extractive backend (still with citations).
ANTHROPIC_API_KEY=
DOCMIND_CLAUDE_MODEL=claude-opus-5-5
DOCMIND_EMBEDDER=fastembed   # or "hashing" for a dependency-free offline mode
DOCMIND_LLM=auto             # auto | claude | extractive
DOCMIND_TOP_K=5
DOCMIND_CHUNK_SIZE=800
DOCMIND_CHUNK_OVERLAP=120
